    <script id="c3accessibility-init">
        window.c3accessibility ??= {};
        window.c3accessibility.commitSettings = (settings) => {
            const usedKeys = [];
            for (const [key, value] of Object.entries(settings)) {
                const capitalized = key.charAt(0).toUpperCase() + key.slice(1);
                const dataKey = `c3accessibility${capitalized}`;
                document.documentElement.dataset[dataKey] = value;
                usedKeys.push(dataKey);
            }
            for (const [key] of Object.entries(document.documentElement.dataset)) {
                if (!usedKeys.includes(key)) {
                    delete document.documentElement.dataset[key];
                }
            }
            localStorage.setItem('c3accessibility.settings', JSON.stringify(settings));
        };
        window.c3accessibility.getSettings = () => {
            return JSON.parse(localStorage.getItem('c3accessibility.settings') ?? '{}');
        };
        window.c3accessibility.getSettingsUrl = () => {
            const url = new URL(location);
            for (const [key, value] of Object.entries(window.c3accessibility.getSettings())) {
                url.searchParams.set(`c3accessibility[${key}]`, value);
            }
            return url.toString();
        };
        window.c3accessibility.commitSettings(window.c3accessibility.getSettings());
        window.c3accessibility.assets = {
            icons: {"Access":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/Access.svg","DropDown":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/DropDown.svg","DropDownClose":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/DropDownClose.svg","FontDefault":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/FontDefault.svg","FontLarger":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/FontLarger.svg","FontLargest":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/FontLargest.svg","LineDefault":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/LineDefault.svg","LineLarger":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/LineLarger.svg","LineLargest":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/LineLargest.svg","OpenIn":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/OpenIn.svg","OptionColorFilter":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/OptionColorFilter.svg","OptionFontFamily":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/OptionFontFamily.svg","OptionFontSize":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/OptionFontSize.svg","OptionGraphics":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/OptionGraphics.svg","OptionLineHeight":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/OptionLineHeight.svg","OptionReduceMotion":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/OptionReduceMotion.svg","OptionScreenreader":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/OptionScreenreader.svg","Reject":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/Reject.svg","Save":"https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/icons\/Save.svg"},
            styles: {accessibility: "https:\/\/www.senertec.de\/wp-content\/plugins\/c3-accessibility\/assets\/css\/accesibility.css" }
        };
    </script>
    
